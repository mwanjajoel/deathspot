# Deathspot UG configuration, shared by docker compose and `pnpm dev`.
# Generate a real one with secrets filled in:   pnpm setup:env
# NEVER commit your .env.

############ Public URLs (change for your VPS)
# Where people open the app.
SITE_URL=http://localhost:3000
# Supabase gateway (API + Studio dashboard). With the https profile: https://$SUPABASE_DOMAIN
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1

############ First admin (created on first start if no admin exists yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

############ Secrets (pnpm setup:env generates these)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=
VOTER_SALT=

############ Database
POSTGRES_DB=postgres
POSTGRES_EXPOSE_PORT=55432
JWT_EXPIRY=3600

############ Ports / binding
APP_PORT=3000
# Set to 127.0.0.1 when Caddy (https profile) fronts the app.
APP_BIND=0.0.0.0
API_GW_HTTP_PORT=8000
API_GW_BIND=127.0.0.1

############ HTTPS with Caddy (docker compose --profile https up -d)
# Behind Cloudflare's proxy: CADDYFILE=Caddyfile.cloudflare and put the Origin CA certificate in
# docker/caddy/certs/origin.pem + origin.key. Without Cloudflare: leave as Caddyfile (Let's Encrypt).
CADDYFILE=Caddyfile
APP_DOMAIN=deathspot.org
SUPABASE_DOMAIN=supabase.deathspot.org
ACME_EMAIL=you@example.com

############ Optional SMTP (password reset emails for moderators)
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Deathspot UG"

############ Third-party services
# Identify your deployment to OpenStreetMap Nominatim (required by their usage policy).
# Use a real site or repo URL: Nominatim rejects placeholder domains like example.com with 403.
NOMINATIM_USER_AGENT="DeathspotUG/0.2 (community safety map; https://deathspot.org)"
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

############ Used by `pnpm dev` on the host (docker compose overrides these for the app container)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@127.0.0.1:55432/postgres

# Daily backups to Cloudflare R2 (the `backup` service; `--profile backup` with docker-compose.yml).
# Create a bucket, then an R2 API token with Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts every backup (AES-256). Store it somewhere safe: without it the backups can't be restored.
BACKUP_ENCRYPTION_KEY=
BACKUP_HOUR=1
BACKUP_RETENTION_DAYS=30
