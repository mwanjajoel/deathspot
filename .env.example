# Where the SQLite database lives (default: ./data/deathspot.db). Must be on a persistent, writable disk.
# DATABASE_PATH=/var/lib/deathspot/deathspot.db

# Secret salt for anonymous voter ids. Set a long random value in production.
VOTER_SALT=change-me

# Identify your deployment to OpenStreetMap Nominatim (required by their usage policy).
NOMINATIM_USER_AGENT="DeathspotUG/0.1 (https://your-domain.example; you@example.com)"

# Optional: use your own map tile provider for heavy traffic.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
