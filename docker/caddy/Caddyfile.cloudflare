# Caddy behind the Cloudflare proxy (orange cloud), with SSL mode "Full (strict)".
#
# - TLS uses a Cloudflare Origin CA certificate for deathspot.org and *.deathspot.org, mounted at
#   /certs (docker/caddy/certs/origin.pem + origin.key on the server, never committed).
# - The real visitor IP is taken from CF-Connecting-IP only when the request comes from a
#   Cloudflare address, then passed to the app as X-Forwarded-For. CF-Connecting-IP itself is
#   stripped, so a client that reaches the server directly can't spoof it. The firewall
#   (scripts/server-setup.sh) also only lets Cloudflare reach ports 80 and 443.
# - Cloudflare ranges: https://www.cloudflare.com/ips (refresh this list if they change).
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_origin) {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip
}

# Public app
{$APP_DOMAIN} {
	import cloudflare_origin
	reverse_proxy app:3000 {
		header_up -CF-Connecting-IP
		header_up X-Forwarded-For {client_ip}
	}
}

# Supabase API gateway + Studio dashboard (basic auth: DASHBOARD_USERNAME / DASHBOARD_PASSWORD).
{$SUPABASE_DOMAIN} {
	import cloudflare_origin
	reverse_proxy api-gw:8000
}
