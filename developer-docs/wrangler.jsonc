{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deathspot-docs",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Serves the static docs at https://docs.deathspot.org. Cloudflare creates the DNS record and
  // certificate for a custom domain automatically (the deathspot.org zone is on Cloudflare).
  "routes": [{ "pattern": "docs.deathspot.org", "custom_domain": true }],
  // Only serve from the custom domain, not a *.workers.dev URL.
  "workers_dev": false
}
